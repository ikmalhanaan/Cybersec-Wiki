---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import RelatedFiles from '../../components/RelatedFiles.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import DecisionTree from '../../components/DecisionTree.astro';
import pages from '../../data/pages.json';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Map ID to Slug for in-text link replacement
const idToSlugMap = Object.fromEntries(pages.map(p => [p.id, p.slug]));

// Detect if this document has an Interactive Decision Guide section
const interactiveGuideHeading = headings.find(h => 
  h.text.toLowerCase().includes('interactive decision') || 
  h.text.toLowerCase().includes('decision guide')
);
---

<BaseLayout 
  title={`${entry.data.id}. ${entry.data.title} | Cyber Security Wiki`}
  currentPath={`/docs/${entry.slug}`}
>
  <div class="flex max-w-[96rem] mx-auto w-full min-h-[calc(100vh-4rem)]">
    <!-- LEFT SIDEBAR: Category navigation, highlight active file, collapsible per group -->
    <Sidebar currentSlug={entry.slug} />

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 min-w-0 px-4 sm:px-8 py-8 lg:px-10 max-w-5xl">
      <!-- Breadcrumb & Document Meta Header -->
      <div class="mb-8 pb-6 border-b border-[#30363d] space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <a href="/" class="text-[#8b949e] hover:text-[#f0f6fc]">Home</a>
          <span class="text-[#484f58]">/</span>
          <span class="text-[#00b4d8] font-semibold">{entry.data.category}</span>
          <span class="text-[#484f58]">/</span>
          <span class="px-2 py-0.5 rounded bg-[#21262d] text-[#e84a5f] border border-[#30363d] font-bold">
            MOD-{entry.data.id}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-[#f0f6fc] tracking-tight font-sans">
          {entry.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-[#8b949e] pt-1">
          {entry.data.filename && (
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#8b949e]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              <span>{entry.data.filename}</span>
            </div>
          )}
          <div class="flex items-center gap-3">
            <span>
              Inbound Refs: <strong class="text-[#10b981]">{entry.data.refs_in.length}</strong>
            </span>
            <span>
              Outbound Refs: <strong class="text-[#00b4d8]">{entry.data.refs_out.length}</strong>
            </span>
          </div>
        </div>
      </div>

      <!-- Interactive Decision Guide Banner if Available -->
      {interactiveGuideHeading && (
        <div class="mb-8 p-4 rounded-xl bg-gradient-to-r from-[#e84a5f]/15 via-[#161b22] to-[#00b4d8]/15 border border-[#e84a5f]/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-lg">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-3 h-3 mt-1 sm:mt-0 rounded-full bg-[#e84a5f] animate-ping flex-shrink-0"></span>
            <div>
              <div class="font-bold text-sm text-[#f0f6fc] font-mono flex items-center gap-2 flex-wrap">
                <span>🎯 Interactive Decision Guide</span>
                <span class="text-[10px] uppercase px-2 py-0.5 rounded bg-[#e84a5f] text-white font-bold tracking-wider">
                  Available
                </span>
              </div>
              <p class="text-xs text-[#8b949e] font-sans mt-0.5">
                Dokumen ini memiliki panduan alur keputusan langkah-demi-langkah (Pre-flight, Fase Operasi, Troubleshooting & Cheatsheet).
              </p>
            </div>
          </div>
          <a 
            href={`#${interactiveGuideHeading.slug}`} 
            class="px-3.5 py-2 rounded-lg bg-[#e84a5f] hover:bg-[#ff5768] text-white text-xs font-mono font-bold transition-all shadow flex items-center gap-1.5 flex-shrink-0 whitespace-nowrap self-stretch sm:self-auto justify-center"
          >
            <span>Lompat ke Guide</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      )}

      <!-- Rendered Markdown Body -->
      <article id="doc-article-content" class="prose prose-invert max-w-none text-[#c9d1d9]">
        <Content />
      </article>

      <!-- Bottom Reference Cards for Mobile / Small Screens -->
      <div class="block xl:hidden mt-12 pt-8 border-t border-[#30363d]">
        <RelatedFiles 
          currentId={entry.data.id} 
          currentSlug={entry.slug} 
          refsIn={entry.data.refs_in} 
          refsOut={entry.data.refs_out} 
        />
      </div>
    </main>

    <!-- RIGHT SIDEBAR: Related Files panel (Leads to & Referenced by + SMB Pivot Shortcuts) -->
    <RelatedFiles 
      currentId={entry.data.id} 
      currentSlug={entry.slug} 
      refsIn={entry.data.refs_in} 
      refsOut={entry.data.refs_out} 
    />
  </div>

  <!-- Interactive Client Enhancements: Copy Buttons & ASCII-to-Mermaid Decision Tree -->
  <CodeBlock />
  <DecisionTree />

  <!-- Script to replace any plain-text mentions of XX_namafile.md with clickable links -->
  <script define:vars={{ idToSlug: idToSlugMap }}>
    function linkifyPlainReferences() {
      const article = document.getElementById('doc-article-content');
      if (!article) return;

      const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
        acceptNode: function(node) {
          // Skip if already inside an <a>, <pre>, <code>, or script tag
          let parent = node.parentElement;
          while (parent && parent !== article) {
            if (['A', 'PRE', 'CODE', 'SCRIPT', 'BUTTON'].includes(parent.tagName)) {
              return NodeFilter.FILTER_REJECT;
            }
            parent = parent.parentElement;
          }
          return NodeFilter.FILTER_ACCEPT;
        }
      });

      const textNodes = [];
      while (walker.nextNode()) {
        textNodes.push(walker.currentNode);
      }

      const fileRegex = /\b(\d{2}[a-z]?)[-_][a-zA-Z0-9_& -]+\.md\b/gi;

      textNodes.forEach(node => {
        const text = node.nodeValue;
        if (!text || !fileRegex.test(text)) return;

        fileRegex.lastIndex = 0;
        const span = document.createElement('span');
        let lastIndex = 0;
        let match;

        while ((match = fileRegex.exec(text)) !== null) {
          const matchStart = match.index;
          const matchEnd = fileRegex.lastIndex;
          const matchedFilename = match[0];
          const targetId = match[1].toLowerCase();
          const targetSlug = idToSlug[targetId];

          // Append text before match
          if (matchStart > lastIndex) {
            span.appendChild(document.createTextNode(text.substring(lastIndex, matchStart)));
          }

          if (targetSlug) {
            const a = document.createElement('a');
            a.href = `/docs/${targetSlug}`;
            a.className = 'text-[#00b4d8] underline hover:text-[#38bdf8] font-mono text-xs';
            a.textContent = matchedFilename;
            span.appendChild(a);
          } else {
            span.appendChild(document.createTextNode(matchedFilename));
          }

          lastIndex = matchEnd;
        }

        if (lastIndex < text.length) {
          span.appendChild(document.createTextNode(text.substring(lastIndex)));
        }

        node.parentNode?.replaceChild(span, node);
      });
    }

    document.addEventListener('DOMContentLoaded', linkifyPlainReferences);
    linkifyPlainReferences();
  </script>
</BaseLayout>
