                      <span class="text-[10px] font-mono uppercase tracking-wider text-[#10b981] font-bold">📸 Bukti yang Harus Diarsip:</span>
                      <p class="text-[#8b949e] text-[11px] font-mono">${(sig.evidence_to_capture || []).join(' • ')}</p>
