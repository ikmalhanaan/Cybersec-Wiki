              <p class="text-[#c9d1d9] leading-relaxed">${node.ctf_notes}</p>
              <div class="p-3 rounded-lg bg-[#161b22] border border-[#30363d] text-[11px] text-[#8b949e] space-y-1">
                <span class="font-mono font-bold text-[#f0f6fc] block">Karakteristik CTF:</span>
                <span>Fokus pada time-to-flag, celah sengaja diimplan, asumsi dependensi rentan tidak di-patch.</span>
              </div>
            </div>

            <!-- Pentest Notes -->
            <div class="p-5 rounded-xl bg-[#0d1117] border border-[#00b4d8]/40 space-y-3">
              <div class="flex items-center gap-2 font-mono font-bold text-[#00b4d8] text-sm">
                <span>🏢</span>
                <span>Perspektif Pentest Enterprise & RoE</span>
              </div>
              <p class="text-[#c9d1d9] leading-relaxed">${node.pentest_notes}</p>
              <div class="p-3 rounded-lg bg-[#161b22] border border-[#30363d] text-[11px] text-[#8b949e] space-y-1">
                <span class="font-mono font-bold text-[#f0f6fc] block">Karakteristik Real Pentest:</span>
                <span>Wajib pembuktian dampak bisnis (business impact), verifikasi akun uji legal, hindari DoS atau lock out admin.</span>
              </div>
            </div>
          </div>
        `;
      }

      if (tab === 'routes') {
        return `
          <div class="space-y-5 text-xs">
            <!-- Relevant Workflows -->
            <div class="space-y-3">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] uppercase tracking-wider block">
                Rute Langsung ke Modul Workflow Pentesting (${node.relevant_workflows?.length || 0})
              </span>

              <div class="grid grid-cols-1 gap-3">
                ${(node.relevant_workflows || []).map(rw => `
                  <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] transition-colors space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <div>
                        <span class="text-[10px] font-mono text-[#8b949e] block">Workflow Dokumen:</span>
                        <h4 class="font-mono font-bold text-sm text-[#00b4d8]">${rw.title}</h4>
                      </div>
                      <a 
                        href="/docs/${rw.slug}#${rw.anchor || ''}" 
                        target="_blank"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#00b4d8]/15 hover:bg-[#00b4d8]/25 border border-[#00b4d8]/30 text-[#00b4d8] font-mono text-xs font-semibold transition-colors self-start sm:self-auto"
                      >
                        <span>Buka Workflow</span>
                        <span>→</span>
                      </a>
                    </div>

                    <div class="p-2.5 rounded-lg bg-[#161b22] border border-[#30363d] space-y-1">
                      <span class="text-[10px] font-mono text-[#8b949e] uppercase block">Bagian Target:</span>
                      <span class="font-mono text-[#f0f6fc]">${rw.section_title}</span>
                    </div>

                    <p class="text-[#c9d1d9] leading-relaxed">
                      <strong class="text-[#8b949e]">Rationale: </strong> ${rw.rationale}
                    </p>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Related Lateral Pivot Observations -->
            <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-3">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] uppercase tracking-wider block">
                🔄 Observasi Terkait untuk Pivot Lateral
              </span>
              <p class="text-[#8b949e] text-xs">
                Klik observasi di bawah untuk langsung beralih ke node investigasi lateral dalam Navigator:
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                ${(node.related_observations || []).map(relId => `
                  <button 
                    type="button" 
                    class="related-obs-tag px-3 py-1.5 rounded-lg bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] hover:border-[#00b4d8] text-xs font-mono text-[#00b4d8] transition-colors"
                    data-target-id="${relId}"
                  >
                    ${relId} ➔
                  </button>
                `).join('')}
              </div>
            </div>
          </div>
        `;
      }

      return '';
    }

    // Initialize state from URL hash if available
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && allObservations.some(o => o.id === initialHash)) {
      currentSelectedId = initialHash;
    }

    // First render
    renderFilteredList();
  </script>
</BaseLayout>
