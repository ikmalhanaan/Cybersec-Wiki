                ${Array.isArray(node.what_do_you_see) ? `
                  <ul class="space-y-1.5 pl-1">
                    ${node.what_do_you_see.map(item => `
                      <li class="flex items-start gap-2 text-[#f0f6fc] font-mono text-xs">
                        <span class="text-[#00b4d8] font-bold">›</span>
                        <span>${item}</span>
                      </li>
                    `).join('')}
                  </ul>
                ` : `<p>${node.what_do_you_see}</p>`}
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-1.5">
