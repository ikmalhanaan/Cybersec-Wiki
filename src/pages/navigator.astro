      // Attach drawer listeners
      const toggleUnknownBtn = document.getElementById('toggle-unknown-btn');
      const unknownBody = document.getElementById('unknown-body');
      const unknownArrow = document.getElementById('unknown-arrow');

      toggleUnknownBtn?.addEventListener('click', () => {
        const isClosed = unknownBody?.classList.contains('hidden');
        if (isClosed) {
          unknownBody?.classList.remove('hidden');
          unknownArrow?.classList.add('rotate-180');
        } else {
          unknownBody?.classList.add('hidden');
          unknownArrow?.classList.remove('rotate-180');
        }
      });

      // Attach tab change listeners
      document.querySelectorAll('.console-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeDetailTab = btn.getAttribute('data-tab') || 'summary';
          renderDetailConsole();
        });
      });

      // Attach related observations click handlers
      document.querySelectorAll('.related-obs-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const targetId = tag.getAttribute('data-target-id');
          if (targetId) {
            selectObservation(targetId);
          }
        });
      });
    }

    // Helper: render active tab content
    function renderTabContent(node, tab) {
      if (tab === 'summary') {
        return `
