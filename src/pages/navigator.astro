                    <ul class="space-y-0.5 pl-1">
                      ${(pt.interesting_clues || []).map(clue => `<li class="flex items-start gap-1.5 text-[#c9d1d9]"><span class="text-[#f59e0b]">→</span><span>${clue}</span></li>`).join('')}
