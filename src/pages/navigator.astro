    // Helper: Escape HTML strings
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Dynamic Variable Substitution Engine
    function applyTargetVars(text) {
      if (!text) return '';
      const ip = (varTargetIp?.value || '10.10.11.20').trim();
      const domain = (varTargetDomain?.value || 'target.htb').trim();
      const port = (varTargetPort?.value || '80').trim();
      const user = (varTargetUser?.value || 'admin').trim();

      let res = String(text);

      res = res.replace(/<TARGET_IP>/gi, ip)
               .replace(/<TARGET-IP>/gi, ip)
               .replace(/<IP>/gi, ip)
               .replace(/TARGET_IP/g, ip)
               .replace(/<TARGET>/gi, ip)
               .replace(/10\.10\.10\.100/g, ip)
               .replace(/10\.10\.11\.20/g, ip)
               .replace(/10\.10\.10\.x/gi, ip)
               .replace(/10\.10\.11\.x/gi, ip);

      res = res.replace(/<TARGET_DOMAIN>/gi, domain)
               .replace(/<TARGET-DOMAIN>/gi, domain)
               .replace(/<DOMAIN>/gi, domain)
               .replace(/TARGET_DOMAIN/g, domain)
               .replace(/target\.local/g, domain)
               .replace(/target\.htb/g, domain)
               .replace(/example\.com/g, domain);

      res = res.replace(/<TARGET_PORT>/gi, port)
               .replace(/<PORT>/gi, port);

      res = res.replace(/<TARGET_USER>/gi, user)
               .replace(/<USERNAME>/gi, user)
               .replace(/<USER>/gi, user);

      return res;
    }

    // Helper: Create a Copyable Command Box with 1-Click Copy
    function createCopyableCommand(cmd, label = '') {
