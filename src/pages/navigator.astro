              <ul class="space-y-0.5 pl-1">
                ${node.unknown_guide.what_to_record_immediately.map(r => `<li class="flex items-start gap-1.5"><span class="text-[#f59e0b]">→</span><span>${r}</span></li>`).join('')}
              </ul>
            </div>` : ''}
          </div>
        </div>

        <!-- Detail Tabs Header -->
        <div class="flex flex-wrap items-center gap-1 border-b border-[#30363d] pb-2">
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'summary' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="summary">
            📋 Ringkasan & Konteks
          </button>
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'inspections' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="inspections">
            🔬 Titik Inspeksi (${node.inspection_points?.length || 0})
          </button>
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'signals' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="signals">
            ⚡ Signal Tester
          </button>
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'hypotheses' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="hypotheses">
            🎯 Hipotesis & Stop (${node.hypotheses?.length || 0})
          </button>
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'ctf_pentest' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="ctf_pentest">
            ⚖️ CTF vs Pentest
          </button>
          <button type="button" class="console-tab-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-colors ${activeDetailTab === 'routes' ? 'bg-[#21262d] text-[#00b4d8] font-bold border border-[#30363d]' : 'text-[#8b949e] hover:text-[#f0f6fc]'}" data-tab="routes">
            🚀 Rute Workflow (${node.relevant_workflows?.length || 0})
