      }

      const portRegex = /(\d{1,5})\/(?:tcp|udp)\s+open/gi;
      let match;
      const foundPorts = [];
      while ((match = portRegex.exec(rawText)) !== null) {
        foundPorts.push(parseInt(match[1], 10));
      }

      const isFiltered = /all \d+ scanned ports (?:on [^\s]+ )?are (?:in ignored states|filtered)/i.test(rawText) ||
                         /Host seems down/i.test(rawText);

      selectedPorts.clear();
      portChips.forEach(c => c.classList.remove('active'));

      foundPorts.forEach(p => {
        selectedPorts.add(p);
