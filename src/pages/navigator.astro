                  <!-- Normal Baseline -->
                  <div class="p-2.5 rounded-lg bg-[#10b981]/5 border border-[#10b981]/30 text-xs text-[#c9d1d9]">
                    <span class="text-[10px] font-mono text-[#10b981] uppercase font-bold block mb-1">🟢 Baseline Normal:</span>
                    ${pt.normal_baseline}
