              <span class="font-mono font-bold text-xs text-[#e84a5f] flex items-center gap-1.5 uppercase tracking-wider">
                <span>🛑 Stop Conditions: Kapan Harus Berhenti & Pivot</span>
              </span>
              <ul class="space-y-1.5 pl-1">
                ${(node.stop_conditions || []).map(sc => `
                  <li class="flex items-start gap-2 text-[#c9d1d9]">
                    <span class="text-[#e84a5f] font-mono font-bold">✕</span>
                    <span>${sc}</span>
                  </li>
                `).join('')}
              </ul>
            </div>

            <!-- Common Mistakes -->
            <div class="p-4 rounded-xl bg-[#0d1117] border border-[#f59e0b]/50 space-y-2">
              <span class="font-mono font-bold text-xs text-[#f59e0b] flex items-center gap-1.5 uppercase tracking-wider">
                <span>⚠️ Kesalahan Umum & Bias Konfirmasi</span>
              </span>
              <ul class="space-y-1.5 pl-1">
                ${(node.common_mistakes || []).map(cm => `
                  <li class="flex items-start gap-2 text-[#c9d1d9]">
                    <span class="text-[#f59e0b] font-mono font-bold">!</span>
                    <span>${cm}</span>
                  </li>
