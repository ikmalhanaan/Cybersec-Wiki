                            </div>
                            <div class="pl-7 pt-1">
                              <span class="text-[10px] text-[#10b981] font-mono block">Interpretasi:</span>
                              <span class="text-[#c9d1d9]">${escapeHtml(step.interpretation)}</span>
                            </div>
                          </div>
                        `).join('')}
                      </div>` : ''}
                    </div>
                  `;
                }).join('')}
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#0d1117] border border-[#e84a5f]/50 space-y-2">
              <span class="font-mono font-bold text-xs text-[#e84a5f] flex items-center gap-1.5 uppercase tracking-wider">
                <span>🛑 Stop Conditions: Kapan Harus Berhenti</span>
              </span>
              <ul class="space-y-1.5 pl-1">
                ${(node.stop_conditions || []).map(sc => `
                  <li class="flex items-start gap-2 text-[#c9d1d9]">
                    <span class="text-[#e84a5f] font-mono font-bold">✕</span>
                    <span>${escapeHtml(sc)}</span>
                  </li>
                `).join('')}
              </ul>
            </div>

            <div class="p-4 rounded-xl bg-[#0d1117] border border-[#f59e0b]/50 space-y-2">
              <span class="font-mono font-bold text-xs text-[#f59e0b] flex items-center gap-1.5 uppercase tracking-wider">
                <span>⚠️ Kesalahan Umum & Bias Konfirmasi</span>
              </span>
              <ul class="space-y-1.5 pl-1">
                ${(node.common_mistakes || []).map(cm => `
                  <li class="flex items-start gap-2 text-[#c9d1d9]">
                    <span class="text-[#f59e0b] font-mono font-bold">!</span>
                    <span>${escapeHtml(cm)}</span>
                  </li>
                `).join('')}
              </ul>
            </div>
          </div>
        `;
      }

      if (tab === 'ctf_pentest') {
        return `
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="p-5 rounded-xl bg-[#0d1117] border border-[#e84a5f]/40 space-y-3">
              <div class="flex items-center gap-2 font-mono font-bold text-[#e84a5f] text-sm">
                <span>🚩</span>
                <span>Perspektif CTF / Lab Challenge</span>
              </div>
              <p class="text-[#c9d1d9] leading-relaxed">${escapeHtml(node.ctf_notes)}</p>
            </div>

            <div class="p-5 rounded-xl bg-[#0d1117] border border-[#00b4d8]/40 space-y-3">
              <div class="flex items-center gap-2 font-mono font-bold text-[#00b4d8] text-sm">
                <span>🏢</span>
                <span>Perspektif Pentest Enterprise & RoE</span>
              </div>
              <p class="text-[#c9d1d9] leading-relaxed">${escapeHtml(node.pentest_notes)}</p>
            </div>
          </div>
        `;
      }

      if (tab === 'routes') {
        return `
          <div class="space-y-5 text-xs">
            <div class="space-y-3">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] uppercase tracking-wider block">
                Rute Langsung ke Modul Workflow Pentesting (${node.relevant_workflows?.length || 0})
              </span>

              <div class="grid grid-cols-1 gap-3">
                ${(node.relevant_workflows || []).map(rw => `
                  <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] transition-colors space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                      <div>
                        <span class="text-[10px] font-mono text-[#8b949e] block">Workflow Dokumen:</span>
                        <h4 class="font-mono font-bold text-sm text-[#00b4d8]">${escapeHtml(rw.title)}</h4>
                      </div>
                      <a 
                        href="/docs/${rw.slug}#${rw.anchor || ''}" 
                        target="_blank"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#00b4d8]/15 hover:bg-[#00b4d8]/25 border border-[#00b4d8]/30 text-[#00b4d8] font-mono text-xs font-semibold transition-colors self-start sm:self-auto"
                      >
                        <span>Buka Workflow</span>
                        <span>→</span>
                      </a>
                    </div>

                    <div class="p-2.5 rounded-lg bg-[#161b22] border border-[#30363d] space-y-1">
                      <span class="text-[10px] font-mono text-[#8b949e] uppercase block">Bagian Target:</span>
                      <span class="font-mono text-[#f0f6fc]">${escapeHtml(rw.section_title)}</span>
                    </div>

                    <p class="text-[#c9d1d9] leading-relaxed">
                      <strong class="text-[#8b949e]">Rationale: </strong> ${escapeHtml(rw.rationale)}
                    </p>
                  </div>
                `).join('')}
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-3">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] uppercase tracking-wider block">
                🔄 Observasi Terkait untuk Pivot Lateral
              </span>
              <div class="flex flex-wrap gap-2 pt-1">
                ${(node.related_observations || []).map(relId => `
                  <button 
                    type="button" 
                    class="related-obs-tag px-3 py-1.5 rounded-lg bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] hover:border-[#00b4d8] text-xs font-mono text-[#00b4d8] transition-colors"
                    data-target-id="${relId}"
                  >
                    ${relId} ➔
                  </button>
                `).join('')}
              </div>
            </div>
          </div>
        `;
      }

      return '';
    }

    // Initialize state from URL hash if available
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && allObservations.some(o => o.id === initialHash)) {
      currentSelectedId = initialHash;
    }

    // First render
    renderFilteredList();
  </script>
</BaseLayout>

