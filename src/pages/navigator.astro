---
import BaseLayout from '../layouts/BaseLayout.astro';
import observations from '../data/observations.json';

// Grouping and statistics for UI
const totalObservations = observations.length;
const categories = [...new Set(observations.map(o => o.category))];
const domains = [...new Set(observations.map(o => o.domain))];

// Initial selected observation (first one)
const defaultObservation = observations[0];

// Safe JSON serialization preventing any </script> or < in payloads from closing HTML script tags
const safeObservationsJson = JSON.stringify(observations).replace(/</g, '\\u003c');
---

<BaseLayout 
  title="Observation & Decision Navigator — Cyber Security Wiki"
  description="Pusat navigasi keputusan dan observasi pentesting: panduan interpretasi sinyal, titik inspeksi hierarkis, verifikasi hipotesis, dan rute workflow terarah."
  currentPath="/navigator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Hero Header Section -->
    <div class="relative rounded-2xl border border-[#30363d] bg-gradient-to-br from-[#161b22] via-[#0d1117] to-[#161b22] p-6 sm:p-8 overflow-hidden shadow-2xl">
      <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full bg-[#00b4d8]/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-72 h-72 rounded-full bg-[#e84a5f]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#00b4d8]/15 border border-[#00b4d8]/30 text-[#00b4d8] text-xs font-mono font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            OBSERVATION & DECISION NAVIGATOR
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#e84a5f]/15 border border-[#e84a5f]/30 text-[#e84a5f] text-[11px] font-mono">
            Phase 1 Seed Dataset: {totalObservations} Nodes
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#10b981]/15 border border-[#10b981]/30 text-[#10b981] text-[11px] font-mono">
            24 Master Domains
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#f59e0b]/15 border border-[#f59e0b]/30 text-[#f59e0b] text-[11px] font-mono font-semibold flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#f59e0b] animate-ping"></span>
            Mode Pemula & Interaktif Aktif
          </span>
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl sm:text-4xl font-extrabold text-[#f0f6fc] tracking-tight font-sans">
              Apa yang Anda Lihat di Target?
            </h1>
            <p class="text-sm sm:text-base text-[#8b949e] mt-1 max-w-2xl">
              Jembatan metodologis dari temuan mentah Nmap, response HTTP, token, atau konfigurasi menuju titik inspeksi, pembuktian sinyal, mitigasi rabbit hole, dan rute workflow.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 self-start md:self-auto">
            <!-- Diagnostic Wizard Toggle Button -->
            <button 
              type="button"
              id="toggle-wizard-btn"
              class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#00b4d8]/15 hover:bg-[#00b4d8]/25 border border-[#00b4d8]/40 text-xs font-mono text-[#00b4d8] transition-all group font-bold shadow-lg shadow-[#00b4d8]/10"
            >
              <span class="w-2 h-2 rounded-full bg-[#00b4d8] group-hover:scale-125 transition-transform animate-pulse"></span>
              <span>🎯 Asisten Port & Nmap Scan</span>
              <svg class="w-4 h-4 text-[#00b4d8] group-hover:translate-x-0.5 transition-transform" id="wizard-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Mindset / Methodology Toggle Button -->
            <button 
              type="button"
              id="toggle-mindset-btn"
              class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] border border-[#30363d] text-xs font-mono text-[#f0f6fc] transition-all group"
            >
              <span class="w-2 h-2 rounded-full bg-[#f59e0b] group-hover:animate-ping"></span>
              <span>Prinsip Investigasi</span>
              <svg class="w-4 h-4 text-[#8b949e] group-hover:text-[#f0f6fc] transition-transform" id="mindset-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Collapsible Mental Model & Core Axioms Panel -->
        <div id="mindset-panel" class="hidden pt-4 border-t border-[#30363d]/60">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#e84a5f] flex items-center gap-1.5">
                <span>⛔ CLUE ≠ FINDING ≠ VALIDATED</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Petunjuk mentah atau indikasi visual bukan temuan akhir. Suatu temuan baru sah jika dampak dan keterulangannya telah tervalidasi secara teknis.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#f59e0b] flex items-center gap-1.5">
                <span>⚠️ VERSION ≠ VULNERABLE</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Banner versi lama bukan bukti exploit otomatis jalan. Fitur rentan bisa dinonaktifkan, di-backport patch, atau diblokir WAF.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#00b4d8] flex items-center gap-1.5">
                <span>🔑 CREDENTIAL ≠ VALIDATED</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                String yang menyerupai API key atau password pada file backup/JS bukan temuan valid sampai Anda memverifikasi kredensial tersebut aktif.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#a855f7] flex items-center gap-1.5">
                <span>🚪 LOGIN SUCCESS ≠ AUTH BYPASS</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Menerima respons HTTP 200 setelah manipulasi payload seringkali hanya redirect ke halaman login atau generic error, bukan bypass autentikasi.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#10b981] flex items-center gap-1.5">
                <span>🔄 THE REASONING CHAIN</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed font-mono text-[11px]">
                Observe ➔ Context ➔ Question ➔ Expected ➔ Test ➔ Output ➔ Interpret ➔ Hypothesize ➔ Validate ➔ Route
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#38bdf8] flex items-center gap-1.5">
                <span>🛡️ ABSENCE OF SIGNAL ≠ SECURE</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Hasil negatif pada satu teknik tidak berarti aplikasi bebas celah. Evaluasi vektor alternatif sebelum menyimpulkan target aman.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

﻿    <!-- Guided Diagnostic Wizard & Smart Matcher Panel -->
    <div id="wizard-panel" class="rounded-2xl border border-[#00b4d8]/40 bg-gradient-to-br from-[#161b22] via-[#0d1117] to-[#161b22] p-5 sm:p-6 shadow-2xl space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[#30363d]">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-[#00b4d8]/20 text-[#00b4d8] flex items-center justify-center font-bold text-base border border-[#00b4d8]/30">
            🎯
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-[#f0f6fc] font-sans flex items-center gap-2">
              Guided Diagnostic Wizard & Smart Matcher
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/30">Pemula Friendly</span>
            </h2>
            <p class="text-xs text-[#8b949e]">
              Bingung mulai dari mana? Pilih port terbuka di target atau paste output Nmap untuk rekomendasi jalur observasi otomatis.
            </p>
          </div>
        </div>

        <button 
          type="button" 
          id="close-wizard-btn"
          class="self-end sm:self-auto text-xs font-mono text-[#8b949e] hover:text-[#f0f6fc] px-2.5 py-1 rounded-lg bg-[#21262d] border border-[#30363d] transition-colors"
        >
          ✕ Tutup Asisten
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Jalur 1: Checklist 16 Port Populer (7 cols on lg) -->
        <div class="lg:col-span-7 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#00b4d8] uppercase tracking-wider flex items-center gap-1.5">
              <span>🔌</span> Jalur 1: Checklist Port Terbuka di Nmap
            </span>
            <button 
              type="button" 
              id="btn-reset-ports" 
              class="text-[11px] font-mono text-[#8b949e] hover:text-[#f0f6fc] underline transition-colors"
            >
              Reset Pilihan
            </button>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="port-selector-grid">
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="21" data-service="FTP">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">21</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">FTP</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="22" data-service="SSH">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">22</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">SSH</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="23" data-service="Telnet">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">23</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">Telnet</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="25" data-service="SMTP">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">25</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">SMTP</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="53" data-service="DNS">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">53</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">DNS</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="80" data-service="HTTP">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">80</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">HTTP Web</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="88" data-service="Kerberos">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">88</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">Kerberos (AD)</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="110" data-service="POP3">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">110</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">POP3</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="139" data-service="NetBIOS">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">139</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">NetBIOS</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="445" data-service="SMB">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">445</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">SMB File</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="389" data-service="LDAP">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">389</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">LDAP (AD)</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="443" data-service="HTTPS">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">443</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">HTTPS Web</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="1433" data-service="MSSQL">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">1433</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">MSSQL DB</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="3306" data-service="MySQL">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">3306</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">MySQL DB</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="3389" data-service="RDP">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">3389</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">RDP Remote</span>
            </button>
            <button type="button" class="port-chip p-2 rounded-xl bg-[#0d1117] border border-[#30363d] hover:border-[#00b4d8] text-left transition-all group" data-port="8080" data-service="HTTP-Alt">
              <span class="font-mono font-bold text-xs text-[#f0f6fc] group-hover:text-[#00b4d8]">8080</span>
              <span class="text-[10px] font-mono text-[#8b949e] block">HTTP Alt</span>
            </button>
          </div>

          <!-- Special Quick Button: Filtered / Host Down -->
          <div class="pt-1">
            <button 
              type="button" 
              id="btn-trigger-filtered" 
              class="w-full py-2 px-3 rounded-xl bg-[#0d1117] hover:bg-[#21262d] border border-[#e84a5f]/40 hover:border-[#e84a5f] text-xs font-mono text-[#e84a5f] transition-all flex items-center justify-center gap-2"
            >
              <span>🛡️</span>
              <span>Nmap Melaporkan Semua Port Filtered / Host Seems Down? Klik di Sini!</span>
            </button>
          </div>

          <!-- Dynamic Scenario Detection Alert Box -->
          <div id="scenario-alert-box" class="p-3.5 rounded-xl bg-[#0d1117] border border-[#30363d] text-xs space-y-2">
            <div class="flex items-center gap-2 text-[#8b949e] font-mono text-[11px]">
              <span>💡</span>
              <span>Pilih satu atau beberapa port di atas untuk melihat analisis skenario target dan observasi yang direkomendasikan.</span>
            </div>
          </div>
        </div>

        <!-- Jalur 2: Paste Raw Scan Output (5 cols on lg) -->
        <div class="lg:col-span-5 space-y-3 flex flex-col">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-[#10b981] uppercase tracking-wider flex items-center gap-1.5">
              <span>📋</span> Jalur 2: Paste Output Nmap / Terminal
            </span>
          </div>

          <div class="relative flex-1">
            <textarea 
              id="nmap-paste-input" 
              rows="6" 
              class="w-full p-3 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#10b981] text-xs font-mono text-[#f0f6fc] placeholder-[#8b949e]/60 focus:outline-none transition-colors resize-none"
              placeholder="Paste hasil scan Nmap di sini...&#10;Contoh:&#10;Nmap scan report for 10.10.11.20&#10;22/tcp  open  ssh     OpenSSH 8.9p1&#10;80/tcp  open  http    Apache httpd 2.4.52&#10;445/tcp open  netbios-ssn Samba 4.6"
            ></textarea>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button 
              type="button" 
              id="btn-parse-nmap" 
              class="flex-1 py-2 px-3 rounded-xl bg-[#10b981]/20 hover:bg-[#10b981]/30 border border-[#10b981]/40 text-xs font-mono text-[#10b981] font-bold transition-all flex items-center justify-center gap-1.5 shadow-lg shadow-[#10b981]/10"
            >
              <span>⚡</span>
              <span>Analisis Scan Otomatis</span>
            </button>
            <button 
              type="button" 
              id="btn-clear-nmap" 
              class="py-2 px-3 rounded-xl bg-[#21262d] hover:bg-[#30363d] border border-[#30363d] text-xs font-mono text-[#8b949e] hover:text-[#f0f6fc] transition-colors"
            >
              Bersihkan
            </button>
          </div>

          <div id="nmap-parse-status" class="hidden text-[11px] font-mono p-2.5 rounded-lg border"></div>
        </div>
      </div>
    </div>

    <!-- Global Target Variable Substitution Bar -->
    <div id="target-vars-bar" class="p-4 sm:p-5 rounded-2xl bg-[#161b22] border border-[#30363d] shadow-xl space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#10b981] animate-pulse"></span>
          <span class="text-xs font-mono font-bold text-[#f0f6fc] uppercase tracking-wider">
            Variabel Target Real-Time (Otomatis Menggantikan Nilai pada Perintah)
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-mono text-[#8b949e]">
            Ketik IP target Anda untuk memperbarui semua perintah
          </span>
          <button 
            type="button" 
            id="btn-reset-vars" 
            class="text-[11px] font-mono text-[#00b4d8] hover:underline"
          >
            ↺ Reset
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
        <div class="space-y-1">
          <label for="var-target-ip" class="text-[11px] text-[#8b949e] block font-semibold">
            Target IP (<span class="text-[#00b4d8]">&lt;IP&gt;</span>):
          </label>
          <input 
            type="text" 
            id="var-target-ip" 
            value="10.10.11.20" 
            class="w-full px-3 py-1.5 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#00b4d8] text-[#f0f6fc] text-xs font-mono focus:outline-none transition-colors"
            placeholder="10.10.11.20"
          />
        </div>

        <div class="space-y-1">
          <label for="var-target-domain" class="text-[11px] text-[#8b949e] block font-semibold">
            Target Domain (<span class="text-[#00b4d8]">&lt;DOMAIN&gt;</span>):
          </label>
          <input 
            type="text" 
            id="var-target-domain" 
            value="target.htb" 
            class="w-full px-3 py-1.5 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#00b4d8] text-[#f0f6fc] text-xs font-mono focus:outline-none transition-colors"
            placeholder="target.htb"
          />
        </div>

