          const hasConfidenceMatch = (obs.interesting_signals || []).some(s => s.observation_confidence === currentConfidence);
          if (!hasConfidenceMatch) return false;
        }

        if (selectedPorts.size > 0 && !searchQuery) {
          if (selectedPorts.has(88) || selectedPorts.has(389)) {
            if (obs.category !== 'Active Directory' && obs.category !== 'Network') return false;
          } else if (selectedPorts.has(80) || selectedPorts.has(443) || selectedPorts.has(8080)) {
            if (obs.category !== 'Web' && obs.category !== 'Network') return false;
          }
        }

        if (searchQuery) {
          const haystack = [
            obs.id,
            obs.title,
            obs.domain,
            obs.category,
            obs.what_do_you_see,
            obs.why_it_matters,
            obs.context,
            ...(obs.common_mistakes || []),
            ...(obs.provenance || []),
            ...(obs.inspection_points || []).map(p => `${p.title || p.name} ${p.description || p.why_check}`)
