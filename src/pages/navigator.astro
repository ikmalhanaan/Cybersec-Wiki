      const ipMatch = rawText.match(/Nmap scan report for (?:[^\s\(]+\s+\()?([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\)?/i) ||
                      rawText.match(/\b([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\b/);
      let parsedIp = '';
      if (ipMatch && ipMatch[1]) {
        parsedIp = ipMatch[1];
        if (varTargetIp) varTargetIp.value = parsedIp;
      }

      const domainMatch = rawText.match(/Nmap scan report for ([a-zA-Z0-9.-]+\.[a-zA-Z]{2,})/i);
      let parsedDomain = '';
      if (domainMatch && domainMatch[1] && !domainMatch[1].match(/^\d+\.\d+\.\d+\.\d+$/)) {
        parsedDomain = domainMatch[1];
