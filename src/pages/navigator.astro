---
import BaseLayout from '../layouts/BaseLayout.astro';
import observations from '../data/observations.json';

// Grouping and statistics for UI
const totalObservations = observations.length;
const categories = [...new Set(observations.map(o => o.category))];
const domains = [...new Set(observations.map(o => o.domain))];

// Initial selected observation (first one)
const defaultObservation = observations[0];

// Safe JSON serialization preventing any </script> or < in payloads from closing HTML script tags
const safeObservationsJson = JSON.stringify(observations).replace(/</g, '\\u003c');
---

<BaseLayout 
  title="Observation & Decision Navigator — Cyber Security Wiki"
  description="Pusat navigasi keputusan dan observasi pentesting: panduan interpretasi sinyal, titik inspeksi hierarkis, verifikasi hipotesis, dan rute workflow terarah."
  currentPath="/navigator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Hero Header Section -->
    <div class="relative rounded-2xl border border-[#30363d] bg-gradient-to-br from-[#161b22] via-[#0d1117] to-[#161b22] p-6 sm:p-8 overflow-hidden shadow-2xl">
      <div class="absolute -right-16 -top-16 w-72 h-72 rounded-full bg-[#00b4d8]/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-72 h-72 rounded-full bg-[#e84a5f]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#00b4d8]/15 border border-[#00b4d8]/30 text-[#00b4d8] text-xs font-mono font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            OBSERVATION & DECISION NAVIGATOR
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#e84a5f]/15 border border-[#e84a5f]/30 text-[#e84a5f] text-[11px] font-mono">
            Phase 1 Seed Dataset: {totalObservations} Nodes
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-[#10b981]/15 border border-[#10b981]/30 text-[#10b981] text-[11px] font-mono">
            24 Master Domains
          </span>
        </div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl sm:text-4xl font-extrabold text-[#f0f6fc] tracking-tight font-sans">
              Apa yang Anda Lihat di Target?
            </h1>
            <p class="text-sm sm:text-base text-[#8b949e] mt-1 max-w-2xl">
              Jembatan metodologis dari temuan mentah nmap, response HTTP, token, atau konfigurasi menuju titik inspeksi, pembuktian sinyal, mitigasi rabbit hole, dan rute workflow.
            </p>
          </div>

          <!-- Mindset / Methodology Toggle Button -->
          <button 
            type="button"
            id="toggle-mindset-btn"
            class="self-start md:self-auto flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] border border-[#30363d] text-xs font-mono text-[#f0f6fc] transition-all group"
          >
            <span class="w-2 h-2 rounded-full bg-[#f59e0b] group-hover:animate-ping"></span>
            <span>Prinsip Investigasi & Mindset</span>
            <svg class="w-4 h-4 text-[#8b949e] group-hover:text-[#f0f6fc] transition-transform" id="mindset-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>

        <!-- Collapsible Mental Model & Core Axioms Panel -->
        <div id="mindset-panel" class="hidden pt-4 border-t border-[#30363d]/60">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#e84a5f] flex items-center gap-1.5">
                <span>⛔ CLUE ≠ FINDING ≠ VALIDATED</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Petunjuk mentah atau indikasi visual bukan temuan akhir. Suatu temuan baru sah jika dampak dan keterulangannya telah tervalidasi secara teknis.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#f59e0b] flex items-center gap-1.5">
                <span>⚠️ VERSION ≠ VULNERABLE</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Banner versi lama bukan bukti exploit otomatis jalan. Fitur rentan bisa dinonaktifkan, di-backport patch, atau diblokir WAF.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#00b4d8] flex items-center gap-1.5">
                <span>🔑 CREDENTIAL ≠ VALIDATED</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                String yang menyerupai API key atau password pada file backup/JS bukan temuan valid sampai Anda memverifikasi kredensial tersebut aktif.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#a855f7] flex items-center gap-1.5">
                <span>🚪 LOGIN SUCCESS ≠ AUTH BYPASS</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Menerima respons HTTP 200 setelah manipulasi payload seringkali hanya redirect ke halaman login atau generic error, bukan bypass autentikasi.
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#10b981] flex items-center gap-1.5">
                <span>🔄 THE REASONING CHAIN</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed font-mono text-[11px]">
                Observe ➔ Context ➔ Question ➔ Expected ➔ Test ➔ Output ➔ Interpret ➔ Hypothesize ➔ Validate ➔ Route
              </p>
            </div>

            <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 space-y-1">
              <div class="font-mono font-bold text-[#38bdf8] flex items-center gap-1.5">
                <span>🛡️ ABSENCE OF SIGNAL ≠ SECURE</span>
              </div>
              <p class="text-[#8b949e] leading-relaxed">
                Hasil negatif pada satu teknik tidak berarti aplikasi bebas celah. Evaluasi vektor alternatif sebelum menyimpulkan target aman.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="space-y-4 p-4 sm:p-5 rounded-2xl bg-[#161b22] border border-[#30363d] shadow-lg">
      <div class="flex flex-col md:flex-row gap-3">
        <!-- Live Search Input -->
        <div class="relative flex-1">
          <svg class="w-5 h-5 text-[#00b4d8] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="text" 
            id="obs-search-input"
            class="w-full pl-11 pr-10 py-2.5 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#00b4d8] text-sm text-[#f0f6fc] placeholder-[#8b949e] focus:outline-none transition-colors"
            placeholder="Cari observasi: 'login', 'token', '445 smb', 'suid', 's3 bucket', 'idor', 'jwt', 'sudo'..."
            autocomplete="off"
          />
          <button 
            id="clear-obs-search" 
            type="button" 
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs text-[#8b949e] hover:text-[#f0f6fc] p-1 rounded"
          >
            ✕
          </button>
        </div>

        <!-- Confidence Filter Dropdown -->
        <div class="flex items-center gap-2">
          <label for="confidence-filter" class="text-xs font-mono text-[#8b949e] whitespace-nowrap">Status Keyakinan:</label>
          <select 
            id="confidence-filter"
            class="px-3 py-2 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#00b4d8] text-xs font-mono text-[#f0f6fc] focus:outline-none"
          >
            <option value="ALL">Semua Tingkat Keyakinan</option>
            <option value="CONFIRMED_OBSERVATION">Confirmed Observation</option>
            <option value="PROBABLE_OBSERVATION">Probable Observation</option>
            <option value="UNCONFIRMED_AMBIGUOUS">Unconfirmed / Ambiguous</option>
          </select>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 pt-1 border-t border-[#30363d]/60">
        <span class="text-xs font-mono text-[#8b949e] mr-1">Kategori:</span>
        <button type="button" class="category-pill active px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="ALL">
          Semua ({totalObservations})
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Web">
          🌐 Web Application
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Network">
          🔌 Network Services
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Active Directory">
          🏢 Active Directory
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Privilege Escalation">
          ⚡ Privilege Escalation
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Cloud & Mobile">
          ☁️ Cloud & Mobile
        </button>
        <button type="button" class="category-pill px-3 py-1 rounded-lg text-xs font-mono transition-colors" data-category="Cryptography & Forensics">
          🔐 Cryptography
        </button>
      </div>
    </div>

    <!-- Main Master-Detail Work Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- LEFT PANE: Observation Cards List (4 Cols on lg) -->
      <div class="lg:col-span-4 space-y-3">
        <div class="flex items-center justify-between px-1">
          <span class="text-xs font-mono uppercase tracking-wider text-[#8b949e]">
            Katalog Observasi (<span id="visible-count">{totalObservations}</span>)
          </span>
          <span class="text-[11px] text-[#8b949e]">Pilih untuk deep-dive</span>
        </div>

        <div id="observation-list" class="space-y-2.5 max-h-[750px] overflow-y-auto pr-1">
          <!-- Populated dynamically via client script for search/filter speed -->
        </div>
      </div>

      <!-- RIGHT PANE: Deep-Dive Observation Console (8 Cols on lg) -->
      <div class="lg:col-span-8">
        <div id="observation-detail-console" class="rounded-2xl bg-[#161b22] border border-[#30363d] p-5 sm:p-7 shadow-2xl space-y-6">
          <!-- Dynamically updated by client script -->
        </div>
      </div>

    </div>

    <!-- Footer Information Bar -->
    <div class="p-4 rounded-xl bg-[#161b22]/60 border border-[#30363d] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#8b949e]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
        <span>Metodologi terintegrasi dengan 73 modul ofensif Wiki Cyber Security Hanz.</span>
      </div>
      <div class="flex items-center gap-3 font-mono">
        <a href="/docs/mindset-dan-metodologi" class="text-[#00b4d8] hover:underline">Metodologi Utama →</a>
        <span>•</span>
        <a href="/graph" class="text-[#00b4d8] hover:underline">Peta Graf Workflow →</a>
      </div>
    </div>

  </div>

  <!-- Raw observations JSON injected into client script -->
  <script id="raw-observations-data" type="application/json" set:html={safeObservationsJson}></script>

  <style>
    .category-pill {
      background-color: #0d1117;
      color: #8b949e;
      border: 1px solid #30363d;
    }
    .category-pill:hover {
      color: #f0f6fc;
      border-color: #00b4d8;
    }
    .category-pill.active {
      background-color: #21262d;
      color: #00b4d8;
      border-color: #00b4d8;
      font-weight: 600;
    }

    .obs-card {
      transition: all 0.2s ease-in-out;
      cursor: pointer;
    }
    .obs-card:hover {
      border-color: #00b4d8;
      transform: translateY(-1px);
    }
    .obs-card.active {
      border-color: #00b4d8;
      background-color: rgba(0, 180, 216, 0.08);
      box-shadow: 0 0 15px rgba(0, 180, 216, 0.15);
    }

    /* Custom Scrollbar */
    #observation-list::-webkit-scrollbar {
      width: 6px;
    }
    #observation-list::-webkit-scrollbar-track {
      background: #0d1117;
      border-radius: 4px;
    }
    #observation-list::-webkit-scrollbar-thumb {
      background: #30363d;
      border-radius: 4px;
    }
    #observation-list::-webkit-scrollbar-thumb:hover {
      background: #00b4d8;
    }
  </style>

  <script>
    // Client-side controller for Navigator
    const rawDataEl = document.getElementById('raw-observations-data');
    const allObservations = rawDataEl ? JSON.parse(rawDataEl.textContent || '[]') : [];

    let currentSelectedId = allObservations[0]?.id || '';
    let currentCategory = 'ALL';
    let currentConfidence = 'ALL';
    let searchQuery = '';
    let activeDetailTab = 'summary'; // 'summary' | 'inspections' | 'signals' | 'hypotheses' | 'ctf_pentest' | 'routes'

    const obsListEl = document.getElementById('observation-list');
    const detailConsoleEl = document.getElementById('observation-detail-console');
    const visibleCountEl = document.getElementById('visible-count');
    const searchInput = document.getElementById('obs-search-input');
    const clearSearchBtn = document.getElementById('clear-obs-search');
    const confidenceSelect = document.getElementById('confidence-filter');
    const categoryPills = document.querySelectorAll('.category-pill');
    const toggleMindsetBtn = document.getElementById('toggle-mindset-btn');
    const mindsetPanel = document.getElementById('mindset-panel');
    const mindsetArrow = document.getElementById('mindset-arrow');

    // Mindset toggle
    toggleMindsetBtn?.addEventListener('click', () => {
      const isHidden = mindsetPanel?.classList.contains('hidden');
      if (isHidden) {
        mindsetPanel?.classList.remove('hidden');
        mindsetArrow?.classList.add('rotate-180');
      } else {
        mindsetPanel?.classList.add('hidden');
        mindsetArrow?.classList.remove('rotate-180');
      }
    });

    // Category filter click
    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        categoryPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentCategory = pill.getAttribute('data-category') || 'ALL';
        renderFilteredList();
      });
    });

    // Confidence filter change
    confidenceSelect?.addEventListener('change', (e) => {
      currentConfidence = e.target.value;
      renderFilteredList();
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      if (searchQuery.length > 0) {
        clearSearchBtn?.classList.remove('hidden');
      } else {
        clearSearchBtn?.classList.add('hidden');
      }
      renderFilteredList();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      clearSearchBtn.classList.add('hidden');
      renderFilteredList();
    });

    // Filter logic
    function getFilteredObservations() {
      return allObservations.filter(obs => {
        // Category match
        if (currentCategory !== 'ALL' && obs.category !== currentCategory) {
          return false;
        }

        // Confidence match
        if (currentConfidence !== 'ALL') {
          const hasConfidenceMatch = (obs.interesting_signals || []).some(s => s.observation_confidence === currentConfidence);
          if (!hasConfidenceMatch) return false;
        }

        // Search query match
        if (searchQuery) {
          const haystack = [
            obs.id,
            obs.title,
            obs.domain,
            obs.category,
            obs.what_do_you_see,
            obs.why_it_matters,
            obs.context,
            ...(obs.common_mistakes || []),
            ...(obs.provenance || []),
            ...(obs.inspection_points || []).map(p => `${p.title} ${p.description}`)
          ].join(' ').toLowerCase();

          return haystack.includes(searchQuery);
        }

        return true;
      });
    }

    // Render observation cards on the left pane
    function renderFilteredList() {
      const filtered = getFilteredObservations();
      if (visibleCountEl) visibleCountEl.textContent = filtered.length;

      if (filtered.length === 0) {
        obsListEl.innerHTML = `
          <div class="p-6 text-center rounded-xl bg-[#0d1117] border border-[#30363d] space-y-2">
            <div class="text-2xl">🔍</div>
            <div class="text-sm font-semibold text-[#f0f6fc]">Tidak ada observasi yang cocok</div>
            <p class="text-xs text-[#8b949e]">Coba kata kunci lain atau setel ulang filter kategori.</p>
          </div>
        `;
        detailConsoleEl.innerHTML = `
          <div class="p-12 text-center text-[#8b949e] space-y-2">
            <p class="text-base font-semibold text-[#f0f6fc]">Pilih observasi dari daftar di sebelah kiri</p>
            <p class="text-xs">Ubah kata pencarian untuk melihat hasil lainnya.</p>
          </div>
        `;
        return;
      }

      // If current selected is not in filtered, select the first available
      if (!filtered.some(o => o.id === currentSelectedId)) {
        currentSelectedId = filtered[0].id;
      }

      obsListEl.innerHTML = filtered.map(obs => {
        const isActive = obs.id === currentSelectedId;
        const activeClass = isActive ? 'active' : '';
        
        let categoryColor = 'text-[#00b4d8] bg-[#00b4d8]/10 border-[#00b4d8]/30';
        if (obs.category === 'Active Directory') categoryColor = 'text-[#f59e0b] bg-[#f59e0b]/10 border-[#f59e0b]/30';
        if (obs.category === 'Privilege Escalation') categoryColor = 'text-[#e84a5f] bg-[#e84a5f]/10 border-[#e84a5f]/30';
        if (obs.category === 'Cloud & Mobile') categoryColor = 'text-[#38bdf8] bg-[#38bdf8]/10 border-[#38bdf8]/30';
        if (obs.category === 'Cryptography & Forensics') categoryColor = 'text-[#a855f7] bg-[#a855f7]/10 border-[#a855f7]/30';

        return `
          <div 
            class="obs-card p-3.5 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-2 ${activeClass}"
            data-id="${obs.id}"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-md border ${categoryColor}">
                ${obs.domain}
              </span>
              <span class="text-[10px] font-mono text-[#8b949e]">
                ${obs.relevant_workflows?.length || 0} WFs
              </span>
            </div>

            <h3 class="text-xs font-semibold text-[#f0f6fc] leading-snug">
              ${obs.title}
            </h3>

            <p class="text-[11px] text-[#8b949e] line-clamp-2 leading-relaxed font-mono">
              ${Array.isArray(obs.what_do_you_see) ? obs.what_do_you_see.join(' • ') : obs.what_do_you_see}
            </p>
          </div>
        `;
      }).join('');

      // Add click listeners to cards
      document.querySelectorAll('.obs-card').forEach(card => {
        card.addEventListener('click', () => {
          const id = card.getAttribute('data-id');
          if (id) {
            selectObservation(id);
          }
        });
      });

      renderDetailConsole();
    }

    // Select observation by ID
    function selectObservation(id) {
      currentSelectedId = id;
      window.location.hash = id;
      document.querySelectorAll('.obs-card').forEach(card => {
        if (card.getAttribute('data-id') === id) {
          card.classList.add('active');
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          card.classList.remove('active');
        }
      });
      renderDetailConsole();
    }

    // Render Right Detail Console
    function renderDetailConsole() {
      const node = allObservations.find(o => o.id === currentSelectedId);
      if (!node) return;

      // Extract confidence badge from first interesting signal or fallback
      const primaryConfidence = node.interesting_signals?.[0]?.observation_confidence || 'CONFIRMED_OBSERVATION';
      let confBadgeClass = 'bg-[#10b981]/15 text-[#10b981] border-[#10b981]/30';
      if (primaryConfidence === 'PROBABLE_OBSERVATION') confBadgeClass = 'bg-[#f59e0b]/15 text-[#f59e0b] border-[#f59e0b]/30';
      if (primaryConfidence === 'UNCONFIRMED_AMBIGUOUS') confBadgeClass = 'bg-[#e84a5f]/15 text-[#e84a5f] border-[#e84a5f]/30';

      detailConsoleEl.innerHTML = `
        <!-- Console Header -->
        <div class="space-y-3 pb-5 border-b border-[#30363d]">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-md bg-[#00b4d8]/15 border border-[#00b4d8]/30 text-[#00b4d8] text-xs font-mono font-medium">
                ${node.domain}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-[#21262d] border border-[#30363d] text-[#8b949e] text-xs font-mono">
                ${node.category}
              </span>
              <span class="px-2 py-0.5 rounded-md border text-[11px] font-mono ${confBadgeClass}">
                Keyakinan: ${primaryConfidence}
              </span>
            </div>

            <span class="text-xs font-mono text-[#8b949e]">ID: ${node.id}</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-[#f0f6fc] font-sans">
            ${node.title}
          </h2>

          <!-- Tri-partite Confidence Matrix Mini-Card -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 p-3 rounded-xl bg-[#0d1117] border border-[#30363d]/80 text-xs">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#8b949e] block">Observation Confidence</span>
              <span class="font-mono font-semibold text-[#00b4d8]">${primaryConfidence}</span>
            </div>
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[#8b949e] block">Hypothesis Status</span>
              <span class="font-mono font-semibold text-[#f59e0b]">ACTIVE_INVESTIGATION</span>
            </div>
            <div>
