          <div>
            <span>Standar: </span>
            <span class="text-[#c9d1d9]">${(node.provenance || []).join(' • ')}</span>
          </div>
          <div>
            <span>Coverage Observasi: </span>
            <span class="text-[#10b981]">${node.coverage?.observation_coverage || 'SEED_INCLUDED'}</span>
          </div>
        </div>
