---
import BaseLayout from '../layouts/BaseLayout.astro';
import categories from '../data/categories.json';
import pages from '../data/pages.json';
import graph from '../data/graph.json';

const pageMap = new Map(pages.map(p => [p.id, p]));

// Statistics calculation
const totalFiles = pages.length;
const totalRefs = graph.edges.length;
const mostReferenced = [...pages].sort((a, b) => b.refs_in.length - a.refs_in.length)[0];
---

<BaseLayout title="Dashboard — Cyber Security Wiki" currentPath="/">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <!-- Hero / Header Section -->
    <div class="relative rounded-2xl border border-[#30363d] bg-gradient-to-br from-[#161b22] via-[#0d1117] to-[#161b22] p-6 sm:p-10 overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-[#e84a5f]/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-64 h-64 rounded-full bg-[#00b4d8]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#e84a5f]/15 border border-[#e84a5f]/30 text-[#e84a5f] text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-[#e84a5f] animate-ping"></span>
          <span>Security Operations & CTF Knowledge Base</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#f0f6fc] tracking-tight font-sans">
          CYBER SECURITY <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#e84a5f] via-[#f59e0b] to-[#00b4d8]">
            WORKFLOW DASHBOARD
          </span>
        </h1>

        <p class="text-sm sm:text-base text-[#8b949e]">
          Pusat navigasi 73 modul ofensif & defensif: Network Services, Active Directory, Web Exploitation, PrivEsc, Binary Reversing, dan Forensics.
        </p>

        <!-- Search Bar with Fuse.js & 300ms Debounce -->
        <div class="pt-2 relative">
          <div class="relative flex items-center">
            <svg class="w-5 h-5 text-[#00b4d8] absolute left-3.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              type="text" 
              id="dashboard-search-input"
              class="w-full pl-11 pr-24 py-3 rounded-xl bg-[#0d1117] border border-[#30363d] focus:border-[#00b4d8] text-sm text-[#f0f6fc] placeholder-[#8b949e] focus:outline-none transition-colors shadow-inner"
              placeholder="Cari modul, exploit, CVE, atau keyword pentest..."
              autocomplete="off"
            />
            <div class="absolute right-3 flex items-center gap-1">
              <kbd class="px-2 py-1 text-[10px] font-mono bg-[#21262d] border border-[#30363d] rounded text-[#8b949e]">Ctrl K</kbd>
            </div>
          </div>

          <!-- Dashboard live search dropdown -->
          <div id="dashboard-search-dropdown" class="absolute left-0 right-0 top-full mt-2 bg-[#161b22] border border-[#30363d] rounded-xl shadow-2xl p-2 z-20 hidden max-h-80 overflow-y-auto space-y-1"></div>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Total Files -->
      <div class="p-5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[#8b949e]">Total Files</span>
          <div class="text-3xl font-extrabold text-[#f0f6fc] font-mono mt-1">{totalFiles}</div>
          <span class="text-[11px] text-[#8b949e] font-sans">Modul dokumentasi terindeks</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-[#00b4d8]/15 border border-[#00b4d8]/30 flex items-center justify-center text-[#00b4d8]">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
      </div>

      <!-- Total Cross-References -->
      <div class="p-5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-[#8b949e]">Cross-References</span>
          <div class="text-3xl font-extrabold text-[#10b981] font-mono mt-1">{totalRefs}</div>
          <span class="text-[11px] text-[#8b949e] font-sans">Koneksi relasi dua arah</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-[#10b981]/15 border border-[#10b981]/30 flex items-center justify-center text-[#10b981]">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </div>
      </div>

      <!-- Most-Referenced File -->
      <div class="p-5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between">
        <div class="min-w-0 pr-2">
          <span class="text-xs font-mono uppercase tracking-wider text-[#8b949e]">Most-Referenced Hub</span>
          <div class="text-lg font-bold text-[#e84a5f] font-mono mt-1 truncate">
            {mostReferenced ? `${mostReferenced.id}. ${mostReferenced.slug}` : '-'}
          </div>
          <span class="text-[11px] text-[#8b949e] font-sans">
            Dirujuk oleh <strong class="text-[#f0f6fc]">{mostReferenced?.refs_in.length || 0}</strong> file lain
          </span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-[#e84a5f]/15 border border-[#e84a5f]/30 flex items-center justify-center text-[#e84a5f] flex-shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- ===== NAVIGATOR FEATURE BANNER ===== -->
    <div class="relative rounded-2xl border border-[#00b4d8]/40 bg-gradient-to-r from-[#00b4d8]/8 via-[#161b22] to-[#00b4d8]/5 p-5 sm:p-6 overflow-hidden shadow-xl">
      <div class="absolute -right-12 -top-12 w-56 h-56 rounded-full bg-[#00b4d8]/8 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-5 justify-between">
        <div class="flex items-start gap-4">
          <!-- Icon -->
          <div class="w-14 h-14 rounded-xl bg-[#00b4d8]/15 border border-[#00b4d8]/40 flex items-center justify-center flex-shrink-0 shadow-lg shadow-[#00b4d8]/10">
            <svg class="w-7 h-7 text-[#00b4d8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>

          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-base sm:text-lg font-bold text-[#f0f6fc] font-mono">
                ✦ OBSERVATION & DECISION NAVIGATOR
              </h2>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#e84a5f]/15 border border-[#e84a5f]/30 text-[#e84a5f]">
                FITUR BARU
              </span>
            </div>
            <p class="text-xs sm:text-sm text-[#8b949e] leading-relaxed max-w-xl">
              <strong class="text-[#c9d1d9]">Apa yang Anda lihat di target?</strong> — Temukan titik inspeksi, interpretasi sinyal, hindari rabbit hole, dan dapatkan rute langsung ke workflow pentesting yang relevan. 38 observasi siap digunakan.
            </p>

            <!-- Mini Axiom Badges -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e]">CLUE ≠ FINDING</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e]">VERSION ≠ VULNERABLE</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#0d1117] border border-[#30363d] text-[#8b949e]">OBSERVE → VALIDATE → ROUTE</span>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <a
          href="/navigator"
          class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#00b4d8] hover:bg-[#00b4d8]/90 text-[#0d1117] font-bold font-mono text-sm transition-all shadow-lg shadow-[#00b4d8]/20 hover:shadow-[#00b4d8]/30 hover:scale-105"
        >
          <span>Buka Navigator</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 9 Workflow Cards Section -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-[#f0f6fc] font-mono tracking-wide flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#00b4d8]"></span>
            9 KATEGORI WORKFLOW PENTESTING
          </h2>
          <p class="text-xs text-[#8b949e] mt-0.5">
            Pilih domain taktis untuk menjelajahi modul operasional.
          </p>
        </div>
        <a 
          href="/graph" 
          class="text-xs font-mono text-[#00b4d8] hover:underline flex items-center gap-1.5"
        >
          <span>Visualisasi Graf</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat, index) => {
          const catDocs = cat.files.map(f => pageMap.get(f)).filter(Boolean);
          const firstDoc = catDocs[0];
          // Mock/calculated progress indicator (100% available/indexed)
          const percentage = 100;

          return (
            <div 
              class="p-5 rounded-xl bg-[#161b22] border border-[#30363d] hover:border-[#8b949e]/60 transition-all duration-200 flex flex-col justify-between group hover:-translate-y-0.5 shadow-lg"
              style={`border-top: 3px solid ${cat.color};`}
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background-color: ${cat.color}; box-shadow: 0 0 8px ${cat.color};`}></span>
                    <h3 class="text-base font-bold text-[#f0f6fc] font-mono">
                      {cat.label}
                    </h3>
                  </div>
                  <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#21262d] border border-[#30363d] text-[#c9d1d9]">
                    {catDocs.length} file
                  </span>
                </div>

                <!-- Progress Indicator Bar -->
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-[10px] font-mono text-[#8b949e]">
                    <span>Dokumentasi Siap</span>
                    <span style={`color: ${cat.color};`}>{percentage}%</span>
                  </div>
                  <div class="w-full h-1.5 rounded-full bg-[#0d1117] overflow-hidden">
                    <div 
                      class="h-full rounded-full transition-all duration-500" 
                      style={`width: ${percentage}%; background-color: ${cat.color};`}
                    ></div>
                  </div>
                </div>

                <!-- Module preview list -->
                <ul class="space-y-1.5 pt-2 text-xs font-mono">
                  {catDocs.slice(0, 3).map(doc => (
                    <li>
                      <a 
                        href={`/docs/${doc?.slug}`} 
                        class="flex items-center gap-2 text-[#8b949e] hover:text-[#f0f6fc] transition-colors truncate"
                      >
                        <span class="text-[10px] px-1 py-0.2 rounded bg-[#0d1117] text-[#c9d1d9] border border-[#30363d]">
                          {doc?.id}
                        </span>
                        <span class="truncate">{doc?.title}</span>
                      </a>
                    </li>
                  ))}
                  {catDocs.length > 3 && (
                    <li class="text-[10px] text-[#6e7681] pl-6 italic">
                      +{catDocs.length - 3} modul lainnya...
                    </li>
                  )}
                </ul>
              </div>

              <!-- Card Action Button -->
              <div class="pt-4 border-t border-[#30363d] mt-4 flex items-center justify-between">
                <span class="text-[10px] font-mono text-[#8b949e]">
                  ID: {cat.id}
                </span>
                {firstDoc && (
                  <a 
                    href={`/docs/${firstDoc.slug}`}
                    class="text-xs font-mono font-semibold hover:underline flex items-center gap-1 transition-colors"
                    style={`color: ${cat.color};`}
                  >
                    <span>Mulai Belajar</span>
                    <span>→</span>
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ pagesData: pages }}>
  import Fuse from 'fuse.js';

  const searchInput = document.getElementById('dashboard-search-input');
  const searchDropdown = document.getElementById('dashboard-search-dropdown');

  const fuse = new Fuse(pagesData, {
    keys: [
      { name: 'title', weight: 0.5 },
      { name: 'id', weight: 0.3 },
      { name: 'category', weight: 0.2 },
      { name: 'content', weight: 0.1 }
    ],
    threshold: 0.35,
    minMatchCharLength: 2
  });

  let debounceTimer = null;

  searchInput?.addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const val = e.target.value.trim();
      if (!val) {
        if (searchDropdown) searchDropdown.classList.add('hidden');
        return;
      }

      const results = fuse.search(val).slice(0, 8);
      if (!searchDropdown) return;

      if (results.length === 0) {
        searchDropdown.innerHTML = `
          <div class="py-4 text-center text-xs font-mono text-[#8b949e]">
            Tidak ada modul yang cocok dengan "${val}".
          </div>
        `;
      } else {
        searchDropdown.innerHTML = results.map(r => {
          const item = r.item;
          return `
            <a 
              href="/docs/${item.slug}" 
              class="flex items-center justify-between p-2.5 rounded-lg hover:bg-[#21262d] transition-colors group"
            >
              <div class="flex items-center gap-2 min-w-0 pr-2">
                <span class="font-mono text-xs px-1.5 py-0.5 rounded bg-[#0d1117] text-[#e84a5f] font-bold border border-[#30363d]">
                  ${item.id}
                </span>
                <span class="text-xs font-semibold text-[#f0f6fc] group-hover:text-[#00b4d8] truncate">
                  ${item.title}
                </span>
              </div>
              <span class="text-[10px] font-mono text-[#8b949e] flex-shrink-0" style="color: ${item.categoryColor};">
                ${item.category}
              </span>
            </a>
          `;
        }).join('');
      }
      searchDropdown.classList.remove('hidden');
    }, 300); // 300ms debounce
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
      searchDropdown?.classList.add('hidden');
    }
  });
</script>
