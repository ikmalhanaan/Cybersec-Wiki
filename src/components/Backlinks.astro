---
import pages from '../data/pages.json';

interface Props {
  refsIn: string[];
  refsOut: string[];
}

const { refsIn = [], refsOut = [] } = Astro.props;

const pageMap = new Map(pages.map(p => [p.id, p]));

const inboundPages = refsIn.map(id => pageMap.get(id)).filter(Boolean);
const outboundPages = refsOut.map(id => pageMap.get(id)).filter(Boolean);
---

<div class="mt-16 pt-8 border-t border-cyber-border space-y-8">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-cyber-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
      <h3 class="text-base font-bold text-slate-100 font-mono tracking-wide">
        CROSS-REFERENCE NETWORK
      </h3>
    </div>
    <a 
      href="/graph" 
      class="text-xs font-mono text-cyber-accent hover:underline flex items-center gap-1"
    >
      <span>Open in Interactive Graph</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Inbound References (Backlinks) -->
    <div class="bg-cyber-surface/50 border border-cyber-border rounded-xl p-4 space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-cyber-border/60">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyber-neon"></span>
          <h4 class="text-xs font-bold font-mono uppercase tracking-wider text-slate-300">
            Inbound References ({inboundPages.length})
          </h4>
        </div>
        <span class="text-[10px] text-slate-500 font-mono">Backlinks</span>
      </div>

      {inboundPages.length === 0 ? (
        <p class="text-xs text-slate-500 italic py-2">
          Belum ada modul lain yang merujuk ke modul ini.
        </p>
      ) : (
        <div class="space-y-1.5 max-h-72 overflow-y-auto pr-1">
          {inboundPages.map(page => (
            <a 
              href={`/docs/${page?.slug}`}
              class="flex items-center justify-between p-2 rounded-lg bg-cyber-card/60 hover:bg-cyber-card border border-cyber-border/60 hover:border-cyber-neon/40 transition-all group"
            >
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-cyber-neon font-bold border border-slate-700">
                  {page?.id}
                </span>
                <span class="text-xs text-slate-300 group-hover:text-cyber-neon transition-colors truncate">
                  {page?.title}
                </span>
              </div>
              <span 
                class="text-[9px] font-mono px-1.5 py-0.5 rounded flex-shrink-0 ml-2 text-slate-400"
                style={`border-left: 2px solid ${page?.categoryColor};`}
              >
                {page?.categoryId}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Outbound References -->
    <div class="bg-cyber-surface/50 border border-cyber-border rounded-xl p-4 space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-cyber-border/60">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyber-accent"></span>
          <h4 class="text-xs font-bold font-mono uppercase tracking-wider text-slate-300">
            Outbound References ({outboundPages.length})
          </h4>
        </div>
        <span class="text-[10px] text-slate-500 font-mono">Next Workflows</span>
      </div>

      {outboundPages.length === 0 ? (
        <p class="text-xs text-slate-500 italic py-2">
          Modul ini tidak memiliki link rujukan keluar ke modul lain.
        </p>
      ) : (
        <div class="space-y-1.5 max-h-72 overflow-y-auto pr-1">
          {outboundPages.map(page => (
            <a 
              href={`/docs/${page?.slug}`}
              class="flex items-center justify-between p-2 rounded-lg bg-cyber-card/60 hover:bg-cyber-card border border-cyber-border/60 hover:border-cyber-accent/40 transition-all group"
            >
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-cyber-accent font-bold border border-slate-700">
                  {page?.id}
                </span>
                <span class="text-xs text-slate-300 group-hover:text-cyber-accent transition-colors truncate">
                  {page?.title}
                </span>
              </div>
              <span 
                class="text-[9px] font-mono px-1.5 py-0.5 rounded flex-shrink-0 ml-2 text-slate-400"
                style={`border-left: 2px solid ${page?.categoryColor};`}
              >
                {page?.categoryId}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
