---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<header class="sticky top-0 z-30 w-full border-b border-[#30363d] bg-[#0d1117]/90 dark:bg-[#0d1117]/90 light:bg-white/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-[#e84a5f]/20 to-[#00b4d8]/20 border border-[#e84a5f]/40 flex items-center justify-center group-hover:border-[#e84a5f] transition-all duration-300">
          <svg class="w-5 h-5 text-[#e84a5f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-mono font-bold tracking-wider text-[#f0f6fc] group-hover:text-[#e84a5f] transition-colors">
              CYBER<span class="text-[#e84a5f]">SEC</span> WIKI
            </span>
            <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-[#e84a5f]/15 text-[#e84a5f] border border-[#e84a5f]/30 font-semibold">
              v4
            </span>
          </div>
          <span class="text-[11px] text-[#8b949e] block -mt-1 font-mono">
            Pentest Master Field Guide
          </span>
        </div>
      </a>
    </div>

    <!-- Center / Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Trigger Button -->
      <button 
        type="button" 
        id="open-search-btn"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#161b22] border border-[#30363d] hover:border-[#00b4d8]/60 text-[#8b949e] hover:text-[#e6edf3] transition-all text-xs font-mono group"
        aria-label="Search documentation"
      >
        <svg class="w-4 h-4 text-[#8b949e] group-hover:text-[#00b4d8] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search docs...</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] bg-[#21262d] border border-[#30363d] rounded text-[#8b949e]">Ctrl K</kbd>
      </button>

      <!-- Navigation Links -->
      <nav class="flex items-center gap-1">
        <a 
          href="/" 
          class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
            currentPath === '/' 
              ? 'bg-[#21262d] text-[#e84a5f] border border-[#30363d] font-semibold' 
              : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
          }`}
        >
          Dashboard
        </a>
        <a 
          href="/navigator" 
          class={`flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
            currentPath === '/navigator' 
              ? 'bg-[#21262d] text-[#00b4d8] border border-[#30363d] font-semibold' 
              : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
          }`}
        >
          <svg class="w-3.5 h-3.5 text-[#00b4d8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <span>Navigator</span>
        </a>
        <a 
          href="/docs/mindset-dan-metodologi" 
          class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
            currentPath.startsWith('/docs') 
              ? 'bg-[#21262d] text-[#00b4d8] border border-[#30363d] font-semibold' 
              : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
          }`}
        >
          Docs
        </a>
        <a 
          href="/graph" 
          class={`flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
            currentPath === '/graph' 
              ? 'bg-[#21262d] text-[#00b4d8] border border-[#30363d] font-semibold' 
              : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
          }`}
        >
          <svg class="w-3.5 h-3.5 text-[#00b4d8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="hidden sm:inline">Graph</span>
        </a>
        <a 
          href="/search" 
          class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
            currentPath === '/search' 
              ? 'bg-[#21262d] text-[#00b4d8] border border-[#30363d] font-semibold' 
              : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
          }`}
        >
          Search
        </a>
      </nav>

      <!-- Light / Dark Mode Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-lg bg-[#161b22] border border-[#30363d] text-[#8b949e] hover:text-[#f0f6fc] hover:border-[#8b949e] transition-colors"
        aria-label="Toggle light/dark mode"
        title="Toggle Light / Dark mode"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden text-[#00b4d8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  toggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
