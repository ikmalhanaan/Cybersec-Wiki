---
import pages from '../data/pages.json';

interface Props {
  currentId: string;
  currentSlug: string;
  refsIn: string[];
  refsOut: string[];
}

const { currentId, currentSlug, refsIn = [], refsOut = [] } = Astro.props;

const pageMap = new Map(pages.map(p => [p.id, p]));

const inboundPages = refsIn.map(id => pageMap.get(id)).filter(Boolean);
const outboundPages = refsOut.map(id => pageMap.get(id)).filter(Boolean);

// Special 1-click cross-workflow shortcuts for 05 SMB & Samba
const isSmbModule = currentId === '05' || currentSlug.includes('smb');
const shortcutPasswordCracking = pageMap.get('63'); // 63_password_cracking_workflow
const shortcutSsh = pageMap.get('06');              // 06_ssh_workflow
---

<aside class="w-72 flex-shrink-0 border-l border-[#30363d] bg-[#0d1117] h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto p-4 hidden xl:block">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between pb-3 border-b border-[#30363d]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#e84a5f]"></span>
        <span class="text-xs font-mono font-bold tracking-wider text-[#8b949e] uppercase">
          Related Files
        </span>
      </div>
      <a 
        href="/graph" 
        class="text-[10px] font-mono text-[#00b4d8] hover:underline flex items-center gap-1"
        title="View in Cytoscape Graph"
      >
        <span>Graph</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- PENTING: Quick 1-Click Cross-Workflow Shortcuts for 05_smb_samba -->
    {isSmbModule && (
      <div class="p-3.5 rounded-xl bg-gradient-to-br from-[#e84a5f]/15 to-[#00b4d8]/10 border border-[#e84a5f]/40 space-y-2.5">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#e84a5f] animate-ping"></span>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#e84a5f]">
            ⚡ SMB Pivot Shortcuts
          </span>
        </div>
        <p class="text-[11px] text-[#c9d1d9] font-sans">
          Navigasi cepat panduan & lintas workflow:
        </p>
        <div class="space-y-1.5 pt-1">
          <a
            href="#smbsamba-complete-attack-workflow--interactive-decision-guide"
            class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#21262d] hover:bg-[#e84a5f]/20 text-[#f0f6fc] text-xs font-mono border border-[#e84a5f]/60 hover:border-[#e84a5f] transition-all group font-medium"
          >
            <span class="truncate text-[#e84a5f]">🎯 Decision Guide</span>
            <span class="text-[10px] text-[#8b949e] group-hover:text-white font-mono">Jump ↓</span>
          </a>
          <a
            href="#master-decision-tree-ringkasan"
            class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#21262d] hover:bg-[#00b4d8]/20 text-[#f0f6fc] text-xs font-mono border border-[#30363d] hover:border-[#00b4d8] transition-all group font-medium"
          >
            <span class="truncate text-[#00b4d8]">📊 Flowchart Tree</span>
            <span class="text-[10px] text-[#8b949e] group-hover:text-[#00b4d8] font-mono">Jump ↓</span>
          </a>
          {shortcutPasswordCracking && (
            <a
              href={`/docs/${shortcutPasswordCracking.slug}`}
              class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#21262d] hover:bg-[#e84a5f] text-[#f0f6fc] text-xs font-mono border border-[#30363d] hover:border-[#e84a5f] transition-all group font-medium"
            >
              <span class="truncate">→ 63. Password Cracking</span>
              <span class="text-[10px] text-[#8b949e] group-hover:text-white font-mono">1-Klik</span>
            </a>
          )}
          {shortcutSsh && (
            <a
              href={`/docs/${shortcutSsh.slug}`}
              class="flex items-center justify-between px-3 py-2 rounded-lg bg-[#21262d] hover:bg-[#00b4d8] text-[#f0f6fc] hover:text-[#0d1117] text-xs font-mono border border-[#30363d] hover:border-[#00b4d8] transition-all group font-medium"
            >
              <span class="truncate">→ 06. SSH Workflow</span>
              <span class="text-[10px] text-[#8b949e] group-hover:text-[#0d1117] font-mono">1-Klik</span>
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Section 1: → Leads to (refs_out) -->
    <div class="space-y-2.5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-[#00b4d8] font-mono text-xs font-bold">→</span>
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[#e6edf3]">
            Leads To
          </h4>
        </div>
        <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e]">
          {outboundPages.length}
        </span>
      </div>

      {outboundPages.length === 0 ? (
        <p class="text-[11px] text-[#8b949e] italic py-1">
          Tidak ada modul rujukan keluar.
        </p>
      ) : (
        <div class="flex flex-wrap gap-1.5 max-h-64 overflow-y-auto pr-1">
          {outboundPages.map(page => (
            <a
              href={`/docs/${page?.slug}`}
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono transition-all hover:scale-105 border border-transparent"
              style={`background-color: ${page?.categoryColor}18; color: ${page?.categoryColor}; border-color: ${page?.categoryColor}40;`}
              title={page?.title}
            >
              <span class="font-bold">{page?.id}</span>
              <span class="text-[11px] truncate max-w-[150px]">{page?.slug}</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Section 2: ← Referenced by (refs_in) -->
    <div class="space-y-2.5 pt-4 border-t border-[#30363d]">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-[#10b981] font-mono text-xs font-bold">←</span>
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[#e6edf3]">
            Referenced By
          </h4>
        </div>
        <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-[#161b22] border border-[#30363d] text-[#8b949e]">
          {inboundPages.length}
        </span>
      </div>

      {inboundPages.length === 0 ? (
        <p class="text-[11px] text-[#8b949e] italic py-1">
          Belum ada modul yang merujuk ke halaman ini.
        </p>
      ) : (
        <div class="flex flex-wrap gap-1.5 max-h-72 overflow-y-auto pr-1">
          {inboundPages.map(page => (
            <a
              href={`/docs/${page?.slug}`}
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono transition-all hover:scale-105 border border-transparent"
              style={`background-color: ${page?.categoryColor}18; color: ${page?.categoryColor}; border-color: ${page?.categoryColor}40;`}
              title={page?.title}
            >
              <span class="font-bold">{page?.id}</span>
              <span class="text-[11px] truncate max-w-[150px]">{page?.slug}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</aside>
