---
import graphData from '../data/graph.json';
import categories from '../data/categories.json';
---

<div class="relative w-full h-[calc(100vh-4rem)] bg-[#070a12] overflow-hidden flex flex-col md:flex-row">
  <!-- Top / Left Control Panel -->
  <div class="z-20 w-full md:w-80 p-4 bg-[#0d1322]/95 border-b md:border-b-0 md:border-r border-cyber-border backdrop-blur flex flex-col gap-4 overflow-y-auto">
    <div>
      <h2 class="text-sm font-bold text-slate-100 font-mono tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyber-accent animate-pulse"></span>
        KNOWLEDGE NETWORK GRAPH
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        Visualisasi 73 modul & 575 tautan pentest workflow.
      </p>
    </div>

    <!-- Quick Graph Search -->
    <div>
      <label for="graph-search" class="block text-[11px] font-mono text-slate-400 uppercase mb-1">
        Cari Node / Modul
      </label>
      <input 
        type="text" 
        id="graph-search" 
        placeholder="Filter node (e.g. 05, smb, privesc)..." 
        class="w-full px-3 py-1.5 rounded-lg bg-[#090d16] border border-cyber-border text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyber-accent"
      />
    </div>

    <!-- Category Filter Toggles -->
    <div>
      <span class="block text-[11px] font-mono text-slate-400 uppercase mb-2">
        Filter Kategori
      </span>
      <div class="flex flex-wrap gap-1.5" id="category-filters">
        <button 
          type="button" 
          class="cat-filter-btn active text-[10px] font-mono px-2 py-1 rounded bg-cyber-card text-white border border-cyber-accent"
          data-cat="all"
        >
          Semua (73)
        </button>
        {categories.map(cat => (
          <button 
            type="button" 
            class="cat-filter-btn text-[10px] font-mono px-2 py-1 rounded bg-[#090d16] text-slate-300 border border-cyber-border hover:border-slate-500 transition-colors flex items-center gap-1.5"
            data-cat={cat.id}
          >
            <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${cat.color};`}></span>
            <span>{cat.id}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Selected Node Info Card -->
    <div id="node-info-card" class="mt-auto border border-cyber-border rounded-xl p-3 bg-cyber-surface/70 space-y-2 hidden">
      <div class="flex items-center justify-between">
        <span id="node-id-badge" class="px-2 py-0.5 rounded bg-slate-800 text-cyber-neon font-mono text-xs font-bold border border-slate-700">00</span>
        <span id="node-category-badge" class="text-[10px] font-mono px-2 py-0.5 rounded text-slate-300">Category</span>
      </div>
      <h3 id="node-title" class="text-xs font-bold text-slate-100 line-clamp-2">Title</h3>
      <div class="grid grid-cols-2 gap-2 text-[10px] font-mono text-slate-400 py-1 border-y border-cyber-border/40">
        <div>Inbound: <span id="node-refs-in" class="text-cyber-neon font-bold">0</span></div>
        <div>Outbound: <span id="node-refs-out" class="text-cyber-accent font-bold">0</span></div>
      </div>
      <a 
        id="node-link-btn" 
        href="#" 
        class="block w-full py-1.5 text-center text-xs font-mono font-semibold rounded bg-cyber-accent hover:bg-cyber-accent/80 text-black transition-colors"
      >
        Buka Dokumentasi →
      </a>
    </div>

    <!-- Layout Controls -->
    <div class="flex items-center gap-2 pt-2 border-t border-cyber-border/60">
      <button 
        type="button" 
        id="btn-fit" 
        class="flex-1 py-1 text-[11px] font-mono bg-cyber-surface border border-cyber-border hover:border-slate-500 rounded text-slate-300"
      >
        Fit View
      </button>
      <button 
        type="button" 
        id="btn-re-layout" 
        class="flex-1 py-1 text-[11px] font-mono bg-cyber-surface border border-cyber-border hover:border-slate-500 rounded text-slate-300"
      >
        Re-layout
      </button>
    </div>
  </div>

  <!-- Graph Canvas Container -->
  <div class="relative flex-1 h-full w-full">
    <div id="cy" class="w-full h-full bg-[#070a12]"></div>
    
    <!-- Floating Zoom Controls -->
    <div class="absolute bottom-4 right-4 z-20 flex flex-col gap-1.5 bg-[#0d1322]/90 border border-cyber-border rounded-lg p-1">
      <button id="zoom-in" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-white hover:bg-cyber-surface rounded text-base font-mono">+</button>
      <button id="zoom-out" class="w-7 h-7 flex items-center justify-center text-slate-300 hover:text-white hover:bg-cyber-surface rounded text-base font-mono">-</button>
    </div>
  </div>
</div>

<script define:vars={{ graph: graphData, categoriesData: categories }}>
  import cytoscape from 'cytoscape';

  let cy;
  const cyContainer = document.getElementById('cy');
  const searchInput = document.getElementById('graph-search');
  const infoCard = document.getElementById('node-info-card');
  const nodeIdBadge = document.getElementById('node-id-badge');
  const nodeCatBadge = document.getElementById('node-category-badge');
  const nodeTitle = document.getElementById('node-title');
  const nodeRefsIn = document.getElementById('node-refs-in');
  const nodeRefsOut = document.getElementById('node-refs-out');
  const nodeLinkBtn = document.getElementById('node-link-btn');

  function initCytoscape() {
    if (!cyContainer) return;

    cy = cytoscape({
      container: cyContainer,
      elements: graph,
      style: [
        {
          selector: 'node',
          style: {
            'label': 'data(label)',
            'color': '#cbd5e1',
            'font-family': 'monospace',
            'font-size': '10px',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            'background-color': 'data(color)',
            'width': 'mapData(degree, 0, 40, 16, 42)',
            'height': 'mapData(degree, 0, 40, 16, 42)',
            'border-width': 2,
            'border-color': '#ffffff',
            'border-opacity': 0.3,
            'text-outline-color': '#070a12',
            'text-outline-width': 2,
            'transition-property': 'background-color, line-color, target-arrow-color, width, height',
            'transition-duration': '0.2s'
          }
        },
        {
          selector: 'edge',
          style: {
            'width': 1,
            'line-color': '#1e293b',
            'target-arrow-color': '#334155',
            'target-arrow-shape': 'triangle',
            'curve-style': 'bezier',
            'arrow-scale': 0.7,
            'opacity': 0.6
          }
        },
        {
          selector: 'node:selected',
          style: {
            'border-color': '#38bdf8',
            'border-width': 4,
            'border-opacity': 1
          }
        },
        {
          selector: 'edge.highlighted',
          style: {
            'line-color': '#06b6d4',
            'target-arrow-color': '#06b6d4',
            'width': 2.5,
            'opacity': 1,
            'z-index': 99
          }
        },
        {
          selector: 'node.highlighted',
          style: {
            'border-color': '#10b981',
            'border-width': 3,
            'border-opacity': 1
          }
        },
        {
          selector: 'node.dimmed',
          style: {
            'opacity': 0.15
          }
        },
        {
          selector: 'edge.dimmed',
          style: {
            'opacity': 0.05
          }
        }
      ],
      layout: {
        name: 'cose',
        idealEdgeLength: 80,
        nodeOverlap: 20,
        refresh: 20,
        fit: true,
        padding: 30,
        randomize: false,
        componentSpacing: 100,
        nodeRepulsion: 400000,
        edgeElasticity: 100,
        nestingFactor: 5,
        gravity: 80,
        numIter: 1000,
        initialTemp: 200,
        coolingFactor: 0.95,
        minTemp: 1.0
      }
    });

    // Node click handler
    cy.on('tap', 'node', function (evt) {
      const node = evt.target;
      const data = node.data();

      // Show info card
      if (infoCard) {
        infoCard.classList.remove('hidden');
        if (nodeIdBadge) nodeIdBadge.textContent = data.id;
        if (nodeCatBadge) {
          nodeCatBadge.textContent = data.categoryLabel;
          nodeCatBadge.style.backgroundColor = data.color + '22';
          nodeCatBadge.style.color = data.color;
        }
        if (nodeTitle) nodeTitle.textContent = data.title;
        if (nodeRefsIn) nodeRefsIn.textContent = data.refsInCount;
        if (nodeRefsOut) nodeRefsOut.textContent = data.refsOutCount;
        if (nodeLinkBtn) nodeLinkBtn.href = `/docs/${data.slug}`;
      }

      // Highlight connected edges
      cy.elements().removeClass('highlighted dimmed');
      const connectedEdges = node.connectedEdges();
      const connectedNodes = connectedEdges.connectedNodes();

      cy.elements().addClass('dimmed');
      node.removeClass('dimmed').addClass('highlighted');
      connectedEdges.removeClass('dimmed').addClass('highlighted');
      connectedNodes.removeClass('dimmed');
    });

    cy.on('tap', function (evt) {
      if (evt.target === cy) {
        cy.elements().removeClass('highlighted dimmed');
      }
    });

    // Filter by category
    const filterButtons = document.querySelectorAll('.cat-filter-btn');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'border-cyber-accent', 'bg-cyber-card', 'text-white');
          b.classList.add('bg-[#090d16]', 'text-slate-300');
        });
        btn.classList.add('active', 'border-cyber-accent', 'bg-cyber-card', 'text-white');
        btn.classList.remove('bg-[#090d16]', 'text-slate-300');

        const cat = btn.getAttribute('data-cat');
        if (cat === 'all') {
          cy.elements().show();
        } else {
          cy.elements().hide();
          cy.nodes(`[category = "${cat}"]`).show();
          cy.nodes(`[category = "${cat}"]`).connectedEdges().show();
        }
      });
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        cy.elements().removeClass('highlighted dimmed');
        return;
      }
      cy.elements().addClass('dimmed');
      const matches = cy.nodes().filter(n => {
        const d = n.data();
        return d.label.toLowerCase().includes(q) || 
               d.title.toLowerCase().includes(q) || 
               d.id.toLowerCase() === q;
      });
      matches.removeClass('dimmed').addClass('highlighted');
      if (matches.length > 0) {
        cy.center(matches);
      }
    });

    // Zoom & Fit Buttons
    document.getElementById('btn-fit')?.addEventListener('click', () => cy.fit());
    document.getElementById('zoom-in')?.addEventListener('click', () => cy.zoom(cy.zoom() * 1.25));
    document.getElementById('zoom-out')?.addEventListener('click', () => cy.zoom(cy.zoom() * 0.8));
    document.getElementById('btn-re-layout')?.addEventListener('click', () => {
      cy.layout({ name: 'cose', animate: true }).run();
    });
  }

  document.addEventListener('DOMContentLoaded', initCytoscape);
  initCytoscape();
</script>
