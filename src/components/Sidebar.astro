---
import categories from '../data/categories.json';
import pages from '../data/pages.json';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;

// Build map from file ID to page details
const pageMap = new Map(pages.map(p => [p.id, p]));
---

<aside class="w-72 flex-shrink-0 border-r border-[#30363d] bg-[#0d1117] h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto p-4 hidden md:block">
  <div class="space-y-4">
    <!-- Section Title & Search Shortcut -->
    <div class="flex items-center justify-between pb-3 border-b border-[#30363d]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#00b4d8] animate-pulse"></span>
        <span class="text-xs font-mono font-bold tracking-wider text-[#8b949e] uppercase">
          Workflows
        </span>
      </div>
      <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[#21262d] text-[#00b4d8] border border-[#30363d]">
        {pages.length} docs
      </span>
    </div>

    <!-- Category Groups (Collapsible per workflow group) -->
    <nav class="space-y-2">
      {categories.map((cat, idx) => {
        const catPages = cat.files
          .map(f => pageMap.get(f))
          .filter(Boolean);

        const isActiveCategory = catPages.some(p => p?.slug === currentSlug);

        return (
          <details 
            class="group border border-[#21262d] hover:border-[#30363d] rounded-lg overflow-hidden transition-colors"
            open={isActiveCategory || idx === 0}
          >
            <!-- Collapsible Summary Header -->
            <summary class="flex items-center justify-between px-3 py-2 text-xs font-semibold text-[#c9d1d9] hover:text-[#f0f6fc] cursor-pointer select-none bg-[#161b22] hover:bg-[#21262d] transition-colors">
              <div class="flex items-center gap-2 min-w-0 pr-2">
                <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background-color: ${cat.color}; box-shadow: 0 0 6px ${cat.color}88;`}></span>
                <span class="truncate font-mono text-[11px]">{cat.label}</span>
              </div>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <span class="text-[10px] font-mono text-[#8b949e] px-1.5 py-0.2 rounded bg-[#0d1117] border border-[#30363d]">
                  {catPages.length}
                </span>
                <svg class="w-3.5 h-3.5 text-[#8b949e] group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>

            <!-- Links in this category -->
            <ul class="py-1 px-2 space-y-0.5 bg-[#0d1117]/60">
              {catPages.map((p) => {
                const isCurrent = p?.slug === currentSlug;
                return (
                  <li>
                    <a
                      href={`/docs/${p?.slug}`}
                      class={`group/item flex items-center justify-between px-2.5 py-1.5 text-xs rounded transition-all ${
                        isCurrent
                          ? 'bg-[#e84a5f]/15 text-[#f0f6fc] font-semibold border-l-2 border-[#e84a5f] -ml-[1px]'
                          : 'text-[#8b949e] hover:text-[#f0f6fc] hover:bg-[#161b22]'
                      }`}
                      title={p?.title}
                    >
                      <div class="flex items-center gap-2 min-w-0">
                        <span class={`font-mono text-[10px] px-1 py-0.2 rounded ${
                          isCurrent ? 'bg-[#e84a5f]/25 text-[#e84a5f] font-bold' : 'bg-[#21262d] text-[#8b949e] group-hover/item:text-[#c9d1d9]'
                        }`}>
                          {p?.id}
                        </span>
                        <span class="truncate font-mono text-[11px]">{p?.slug}</span>
                      </div>
                      {p?.refs_in.length > 0 && (
                        <span class="text-[9px] font-mono text-[#8b949e] opacity-0 group-hover/item:opacity-100 transition-opacity">
                          {p.refs_in.length} in
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </nav>
  </div>
</aside>
